classDiagram
    class Owner {
        +name: str
        +available_time: int
        +start_time: str
    }

    class Pet {
        +name: str
        +species: str
    }

    class CareTask {
        +title: str
        +duration_minutes: int
        +priority: str
    }

    class PetScheduler {
        +PRIORITY_ORDER: dict
        +generate_schedule(tasks)
    }

    Owner "1" --> "1" Pet : owns
    Pet "1" --> "*" CareTask : has
    PetScheduler --> CareTask : schedules
    PetScheduler --> Owner : uses constraints